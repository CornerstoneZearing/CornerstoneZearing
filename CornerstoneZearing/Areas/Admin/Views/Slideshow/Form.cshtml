@model CornerstoneZearing.Areas.Admin.Models.SlideshowSlideFormModel
@{
    var isEdit = Model.SlideshowSlideID != Guid.Empty;
    ViewData["Section"] = "Slideshow";
    ViewData["Title"] = isEdit ? "Edit Slide" : "Add Slide";
}

<div class="page-header">
    <h1>@(isEdit ? "Edit Slide" : "Add Slide")</h1>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data">
    @if (isEdit)
    {
        <input type="hidden" asp-for="SlideshowSlideID" />
        <input type="hidden" asp-for="StoredFileName" />
    }
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div style="display:grid;grid-template-columns:1fr 300px;gap:1.25rem;align-items:start;">

        <!-- Left column -->
        <div>
            <div class="card" style="margin-bottom:1.25rem;">
                <div class="card-header">Slide Details</div>
                <div class="card-body">
                    <div class="form-group">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="field-validation-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="AltText"></label>
                        <input asp-for="AltText" class="form-control" placeholder="Describe the image for accessibility" />
                        <span asp-validation-for="AltText" class="field-validation-error"></span>
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label asp-for="Link"></label>
                        <input asp-for="Link" class="form-control" placeholder="https:// (optional)" />
                        <span asp-validation-for="Link" class="field-validation-error"></span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">Image</div>
                <div class="card-body">
                    @if (isEdit && !string.IsNullOrEmpty(Model.StoredFileName))
                    {
                        <div style="margin-bottom:1rem;">
                            <img src="/uploads/slideshow/@Model.StoredFileName"
                                 alt="@Model.AltText"
                                 style="max-width:100%;max-height:200px;object-fit:contain;border-radius:6px;border:1px solid var(--border);" />
                        </div>
                        <p style="font-size:.8rem;color:var(--text-secondary);margin-bottom:.75rem;">Upload a new image to replace the current one, or leave blank to keep it.</p>
                    }
                    <div class="form-group" style="margin-bottom:0;">
                        <label asp-for="ImageFile"></label>
                        <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.gif" class="form-control" />
                        <span asp-validation-for="ImageFile" class="field-validation-error"></span>
                        <p style="font-size:.78rem;color:var(--text-secondary);margin-top:.4rem;margin-bottom:0;">JPG, PNG, or GIF &mdash; max 10 MB</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div>
            <div class="card" style="margin-bottom:1.25rem;">
                <div class="card-header">Save</div>
                <div class="card-body">
                    <button type="submit" class="btn btn-primary" style="width:100%;">
                        <i class="fas fa-floppy-disk"></i> Save Slide
                    </button>
                    <div style="margin-top:.6rem;">
                        <a asp-action="Index" class="btn btn-secondary" style="width:100%;justify-content:center;">
                            Cancel
                        </a>
                    </div>
                </div>
            </div>

            <div class="card" style="margin-bottom:1.25rem;">
                <div class="card-header">Settings</div>
                <div class="card-body">
                    <div class="form-group">
                        <label asp-for="DisplayOrder"></label>
                        <input asp-for="DisplayOrder" type="number" min="0" max="9999" class="form-control" />
                        <span asp-validation-for="DisplayOrder" class="field-validation-error"></span>
                    </div>
                    <div class="form-group" style="margin-bottom:0;">
                        <label class="form-check">
                            <input asp-for="IsActive" />
                            <span style="font-size:.875rem;font-weight:500;color:var(--text-primary);">Active</span>
                        </label>
                    </div>
                </div>
            </div>

            @if (isEdit)
            {
                <div class="card">
                    <div class="card-body">
                        <a asp-action="Delete" asp-route-id="@Model.SlideshowSlideID"
                           class="btn btn-danger" style="width:100%;justify-content:center;">
                            <i class="fas fa-trash"></i> Delete Slide
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
