@model CornerstoneZearing.Data.Entities.Page
@{
    ViewData["Title"] = Model.MetaTitle ?? Model.Name;
    ViewData["MetaDescription"] = Model.MetaDescription;
}

<article class="container">
    <h1>@Model.Name</h1>
    <div class="content">
        @Html.Raw(Model.ContentHtml)
    </div>
</article>