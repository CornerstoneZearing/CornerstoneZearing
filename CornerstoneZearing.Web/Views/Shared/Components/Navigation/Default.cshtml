@model IReadOnlyList<CornerstoneZearing.Web.Services.NavNode>
<ul class="navbar-nav ms-auto mb-2 mb-lg-0">
    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
    @foreach (var node in Model)
    {
        if (node.Children.Count == 0)
        {
            <li class="nav-item"><a class="nav-link" href="/@node.Slug">@node.Title</a></li>
        }
        else
        {
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">@node.Title</a>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="/@node.Slug">@node.Title</a></li>
                    @foreach (var child in node.Children)
                    {
                        <li><a class="dropdown-item" href="/@child.Slug">@child.Title</a></li>
                    }
                </ul>
            </li>
        }
    }
    <li class="nav-item"><a class="nav-link" href="/blog">Blog</a></li>
    <li class="nav-item"><a class="nav-link" href="/sermons">Sermons</a></li>
    <li class="nav-item"><a class="nav-link" href="/events">Events</a></li>
</ul>
