@model CornerstoneZearing.Web.Models.SermonsIndexViewModel
@{
    ViewData["Title"] = "Sermons";
}
<div class="row g-5">
    <div class="col-lg-8">
        <h1 class="mb-4">Sermons</h1>
        @if (Model.Sermons.Count == 0)
        {
            <p class="text-muted">No sermons published yet.</p>
        }
        <div class="list-group">
            @foreach (var s in Model.Sermons)
            {
                <a href="/sermons/@s.SermonID" class="list-group-item list-group-item-action">
                    <div class="d-flex justify-content-between">
                        <span class="fw-medium">@s.Title</span>
                        <span class="text-muted small">@s.SermonDate.ToString("MMM d, yyyy")</span>
                    </div>
                    <span class="text-muted small">@s.Speaker@(s.SermonCategory != null ? " · " + s.SermonCategory.Name : "")</span>
                </a>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <h2 class="h5">Series</h2>
        <ul class="list-unstyled">
            <li><a href="/sermons" class="text-decoration-none">All sermons</a></li>
            @foreach (var c in Model.Categories)
            {
                <li><a href="/sermons?category=@c.Slug" class="text-decoration-none">@c.Name</a></li>
            }
        </ul>
    </div>
</div>
