@model CornerstoneZearing.Web.Models.HomeViewModel
@{
    ViewData["Title"] = "Welcome";
}
<div class="p-5 mb-5 bg-light rounded-3 text-center">
    <h1 class="display-5 fw-semibold">Cornerstone Church of Christ</h1>
    <p class="lead mb-0">Zearing, Iowa — a family of believers seeking to follow Jesus.</p>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <h2 class="h4 mb-3">Recent news</h2>
        @if (Model.RecentPosts.Count == 0)
        {
            <p class="text-muted">No posts yet.</p>
        }
        @foreach (var post in Model.RecentPosts)
        {
            <article class="mb-4">
                <h3 class="h5 mb-1"><a href="/blog/@post.Slug" class="text-decoration-none">@post.Title</a></h3>
                <div class="text-muted small mb-2">@((post.DatePublished ?? post.DateCreated).ToString("MMMM d, yyyy"))</div>
                <p class="mb-0">@post.Summary</p>
            </article>
        }
        <a href="/blog" class="btn btn-outline-secondary btn-sm">All posts</a>
    </div>
    <div class="col-lg-5">
        <h2 class="h4 mb-3">Upcoming events</h2>
        <ul class="list-unstyled">
            @foreach (var e in Model.UpcomingEvents)
            {
                <li class="mb-2">
                    <a href="/events/@e.EventID" class="text-decoration-none fw-medium">@e.Title</a><br />
                    <span class="text-muted small">@e.Start.ToString("ddd, MMM d · h:mm tt")@(string.IsNullOrEmpty(e.Location) ? "" : " · " + e.Location)</span>
                </li>
            }
            @if (Model.UpcomingEvents.Count == 0)
            {
                <li class="text-muted">Nothing scheduled right now.</li>
            }
        </ul>
        <a href="/events" class="btn btn-outline-secondary btn-sm">Full calendar</a>

        @if (Model.LatestSermon != null)
        {
            <hr class="my-4" />
            <h2 class="h4 mb-2">Latest sermon</h2>
            <p class="mb-1"><a href="/sermons/@Model.LatestSermon.SermonID" class="text-decoration-none fw-medium">@Model.LatestSermon.Title</a></p>
            <p class="text-muted small">@Model.LatestSermon.SermonDate.ToString("MMMM d, yyyy")@(string.IsNullOrEmpty(Model.LatestSermon.Speaker) ? "" : " · " + Model.LatestSermon.Speaker)</p>
        }
    </div>
</div>
