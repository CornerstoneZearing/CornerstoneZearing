@model List<CornerstoneZearing.Data.Identity.ApplicationRole>
@{ ViewData["Title"] = "Roles"; }
<div class="page-header">
    <h1>Roles</h1>
    <a class="btn btn-primary" asp-action="Create">New Role</a>
</div>
<table class="data">
    <thead><tr><th>Name</th><th>Description</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td>@r.Name</td>
            <td class="muted">@r.Description</td>
            <td style="text-align:right">
                <a class="btn btn-sm" asp-action="Edit" asp-route-id="@r.Id" title="Edit" aria-label="Edit"><i class="fa-solid fa-pencil"></i></a>
                <form asp-action="Delete" asp-route-id="@r.Id" method="post" onsubmit="return confirm('Delete this role?');" style="display:inline">
                    <button class="btn btn-sm" type="submit" title="Delete" aria-label="Delete"><i class="fa-solid fa-trash-can"></i></button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
