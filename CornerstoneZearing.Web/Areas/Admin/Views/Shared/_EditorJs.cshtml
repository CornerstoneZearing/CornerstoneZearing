@model string
@{
    var fieldName = ViewData["FieldName"] as string ?? "ContentJson";
}
<div id="editor-holder" class="editorjs-holder"></div>
<input type="hidden" id="editor-input" name="@fieldName" value="@(Model ?? "")" />
<script>
    document.addEventListener("DOMContentLoaded", function () {
        window.initEditor({
            holderId: "editor-holder",
            inputId: "editor-input"
        });
    });
</script>
