@model List<UserListItem>
@{ ViewData["Title"] = "Users"; }
<div class="page-header">
    <h1>Users</h1>
    <a class="btn btn-primary" asp-action="Create">New User</a>
</div>
<table class="data">
    <thead><tr><th>Name</th><th>Email</th><th>Roles</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td><a asp-action="Edit" asp-route-id="@u.Id">@u.DisplayName</a></td>
            <td class="muted">@u.Email</td>
            <td class="muted">@(u.Roles.Count == 0 ? "—" : string.Join(", ", u.Roles))</td>
            <td>@(u.IsActive ? Html.Raw("<span class='badge badge-published'>Active</span>") : Html.Raw("<span class='badge badge-archived'>Inactive</span>"))</td>
            <td style="text-align:right">
                <form asp-action="ToggleActive" asp-route-id="@u.Id" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm">@(u.IsActive ? "Deactivate" : "Activate")</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
