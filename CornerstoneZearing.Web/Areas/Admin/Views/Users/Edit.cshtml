@model UserEditViewModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New user" : "Edit user";
}
<div class="page-header">
    <h1>@ViewData["Title"]</h1>
    <a class="btn btn-ghost" asp-action="Index">Back to users</a>
</div>
<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="validation-summary-errors"></div>
    <div class="form-grid">
        <div class="card"><div class="card-body">
            <div class="form-row">
                <label asp-for="Email"></label>
                <input asp-for="Email" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>
            <div class="form-row">
                <label asp-for="FirstName"></label>
                <input asp-for="FirstName" />
            </div>
            <div class="form-row">
                <label asp-for="LastName"></label>
                <input asp-for="LastName" />
            </div>
            <div class="form-row">
                <label asp-for="NewPassword">@(isNew ? "Password" : "Reset password (optional)")</label>
                <input asp-for="NewPassword" type="password" autocomplete="new-password" />
                <div class="hint">Minimum 10 characters.</div>
            </div>
            <div class="form-row checkbox-row">
                <input asp-for="IsActive" />
                <label asp-for="IsActive" style="margin:0">Active</label>
            </div>
        </div></div>
        <div class="card"><div class="card-body">
            <h4 style="margin-top:0">Roles</h4>
            @for (var i = 0; i < Model.Roles.Count; i++)
            {
                <div class="checkbox-row" style="margin-bottom:6px">
                    <input type="checkbox" asp-for="Roles[i].Assigned" />
                    <input type="hidden" asp-for="Roles[i].Name" />
                    <input type="hidden" asp-for="Roles[i].RoleId" />
                    <label style="margin:0">@Model.Roles[i].Name</label>
                </div>
            }
            @if (Model.Roles.Count == 0) { <p class="muted">No roles defined yet.</p> }
        </div></div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save user</button>
        <a class="btn btn-ghost" asp-action="Index">Cancel</a>
    </div>
</form>
