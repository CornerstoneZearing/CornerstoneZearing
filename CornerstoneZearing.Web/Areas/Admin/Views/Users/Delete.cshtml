@model UserListModel
@{
    ViewData["Section"] = "Users";
    ViewData["Title"] = "Delete User";
}

<div class="page-header">
    <h1>Delete User</h1>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</div>

<div class="card" style="max-width:520px;">
    <div class="card-body">
        <p class="text-body-secondary mb-4">
            Are you sure you want to permanently delete this user? This action cannot be undone.
        </p>
        <div class="bg-body-tertiary border rounded-3 p-3 mb-4">
            <div style="font-weight:600;">@Model.DisplayName</div>
            <div class="text-muted">@Model.Email</div>
            @if (Model.Roles.Any())
            {
                <div style="margin-top:.5rem;">
                    @foreach (var role in Model.Roles)
                    {
                        <span class="badge badge-secondary">@role</span>
                        @(" ")
                    }
                </div>
            }
        </div>
        <div class="form-actions">
            <form asp-action="Delete" asp-route-id="@Model.UserID" method="post">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Yes, Delete User
                </button>
            </form>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </div>
</div>
