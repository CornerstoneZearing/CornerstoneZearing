@model List<Post>
@{ ViewData["Title"] = "Posts"; }
<div class="page-header">
    <h1>Posts</h1>
    <div style="display:flex;gap:8px">
        <a class="btn" asp-action="Categories">Categories</a>
        <a class="btn btn-primary" asp-action="Create">New Post</a>
    </div>
</div>
<table class="data">
    <thead><tr><th>Title</th><th>Category</th><th>Status</th><th>Published</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Title</td>
            <td class="muted">@(p.PostCategory?.Name ?? "—")</td>
            <td><partial name="_StatusBadge" model="p.Status" /></td>
            <td class="muted">@(p.DatePublished?.ToString("MMM d, yyyy") ?? "—")</td>
            <td style="text-align:right">
                <a class="btn btn-sm" asp-action="Edit" asp-route-id="@p.PostID" title="Edit" aria-label="Edit"><i class="fa-solid fa-pencil"></i></a>
                <form asp-action="Delete" asp-route-id="@p.PostID" method="post" onsubmit="return confirm('Delete this post?');" style="display:inline">
                    <button class="btn btn-sm" type="submit" title="Delete" aria-label="Delete"><i class="fa-solid fa-trash-can"></i></button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="5" class="muted">No posts yet.</td></tr> }
    </tbody>
</table>
