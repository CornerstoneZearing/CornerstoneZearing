@model CornerstoneZearing.Data.Entities.MediaImage
@{
    ViewData["Section"] = "Media";
    ViewData["Title"] = "Delete Image";
}

<div class="page-header">
    <h1>Delete Image</h1>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back
    </a>
</div>

<div class="card" style="max-width:520px;">
    <div class="card-body">
        <p class="text-body-secondary mb-4">
            Are you sure you want to permanently delete this image? This action cannot be undone.
        </p>
        <div class="bg-body-tertiary border rounded-3 p-3 mb-4">
            <div style="display:flex;gap:1rem;align-items:flex-start;">
                <img src="/uploads/images/@Model.StoredFileName" alt="@Model.AltText"
                     class="rounded border flex-shrink-0" style="width:80px;height:80px;object-fit:cover;" />
                <div>
                    <div style="font-weight:600;margin-bottom:.25rem;">@Model.OriginalFileName</div>
                    <div class="text-muted">@Model.ContentType</div>
                    <div class="text-muted">@((Model.FileSize / 1024.0).ToString("F1")) KB</div>
                    <div class="text-muted">@Model.DateUploaded.ToLocalTime().ToString("MMM d, yyyy")</div>
                </div>
            </div>
        </div>
        <div class="form-actions">
            <form asp-action="Delete" asp-route-id="@Model.MediaImageID" method="post">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Yes, Delete Image
                </button>
            </form>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </div>
</div>
