@model List<Media>
@{ ViewData["Title"] = "Media"; }
<div class="page-header">
    <h1>Media Library</h1>
</div>
<div class="card"><div class="card-body">
    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="stack">
        @Html.AntiForgeryToken()
        <input type="file" name="files" accept="image/*" multiple required />
        <button type="submit" class="btn btn-primary btn-sm">Upload Images</button>
    </form>
</div></div>

<div class="media-grid" style="margin-top:20px">
    @foreach (var m in Model)
    {
        <div class="media-tile">
            <img src="@Url.Action("File", "MediaFiles", new { area = "", id = m.MediaID })" alt="@m.AltText" />
            <div class="meta">
                <div>@m.OriginalFileName</div>
                <div>@m.Width×@m.Height · @(m.SizeBytes / 1024) KB</div>
                <form asp-action="Update" asp-route-id="@m.MediaID" method="post" class="stack" style="margin-top:6px">
                    @Html.AntiForgeryToken()
                    <input type="text" name="altText" value="@m.AltText" placeholder="Alt text" />
                    <div style="display:flex;gap:6px">
                        <button type="submit" class="btn btn-sm">Save</button>
                        <button type="submit" class="btn btn-sm btn-danger" formaction="@Url.Action("Delete", new { id = m.MediaID })" onclick="return confirm('Delete this image?');">Delete</button>
                    </div>
                </form>
            </div>
        </div>
    }
    @if (Model.Count == 0) { <p class="muted">No media uploaded yet.</p> }
</div>
