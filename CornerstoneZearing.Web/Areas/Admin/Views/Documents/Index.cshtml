@model List<Document>
@{ ViewData["Title"] = "Documents"; }
<div class="page-header"><h1>Document Library</h1></div>
<div class="card"><div class="card-body">
    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="stack">
        @Html.AntiForgeryToken()
        <input type="file" name="files" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx" multiple required />
        <button type="submit" class="btn btn-primary btn-sm">Upload Documents</button>
        <div class="hint">Allowed: PDF, Word, Excel, PowerPoint.</div>
    </form>
</div></div>

<table class="data" style="margin-top:20px">
    <thead><tr><th>File</th><th>Type</th><th>Size</th><th>Description</th><th></th></tr></thead>
    <tbody>
    @foreach (var d in Model)
    {
        <tr>
            <td><a href="@Url.Action("Document", "MediaFiles", new { area = "", id = d.DocumentID })" target="_blank">@d.OriginalFileName</a></td>
            <td class="muted">@d.ContentType</td>
            <td class="muted">@(d.SizeBytes / 1024) KB</td>
            <td>
                <form asp-action="Update" asp-route-id="@d.DocumentID" method="post" style="display:flex;gap:6px">
                    @Html.AntiForgeryToken()
                    <input type="text" name="description" value="@d.Description" placeholder="Description" />
                    <button type="submit" class="btn btn-sm">Save</button>
                </form>
            </td>
            <td style="text-align:right">
                <form asp-action="Delete" asp-route-id="@d.DocumentID" method="post" onsubmit="return confirm('Delete this document?');" style="display:inline">
                    <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="5" class="muted">No documents uploaded yet.</td></tr> }
    </tbody>
</table>
