@{
    ViewData["Title"] = "Dashboard";
    var stats = (Dictionary<string, int>)ViewBag.Stats;
}
<div class="page-header"><h1>Dashboard</h1></div>
<div class="stat-row">
    @foreach (var (label, n) in stats)
    {
        <div class="stat"><div class="n">@n</div><div class="l">@label</div></div>
    }
</div>
<div class="card"><div class="card-body">
    <h3 style="margin-top:0">Welcome</h3>
    <p class="muted">Use the sidebar to manage site content. What you can see depends on the permissions granted to your roles.</p>
</div></div>
