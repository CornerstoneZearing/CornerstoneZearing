@model List<Sermon>
@{ ViewData["Title"] = "Sermons"; }
<div class="page-header">
    <h1>Sermons</h1>
    <a class="btn btn-primary" asp-action="Create">New sermon</a>
</div>
<table class="data">
    <thead><tr><th>Title</th><th>Date</th><th>Speaker</th><th>Category</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td><a asp-action="Edit" asp-route-id="@s.SermonID">@s.Title</a></td>
            <td class="muted">@s.SermonDate.ToString("MMM d, yyyy")</td>
            <td class="muted">@(s.Speaker ?? "—")</td>
            <td class="muted">@(s.SermonCategory?.Name ?? "—")</td>
            <td><partial name="_StatusBadge" model="s.Status" /></td>
            <td style="text-align:right">
                <form asp-action="Delete" asp-route-id="@s.SermonID" method="post" onsubmit="return confirm('Delete this sermon?');" style="display:inline">
                    <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="6" class="muted">No sermons yet.</td></tr> }
    </tbody>
</table>
