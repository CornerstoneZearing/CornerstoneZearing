@model List<Page>
@{
    ViewData["Title"] = "Pages";
}
<div class="page-header">
    <h1>Pages</h1>
    <a class="btn btn-primary" asp-action="Create">New Page</a>
</div>
<table class="data">
    <thead>
    <tr><th>Title</th><th>Slug</th><th>Parent</th><th>Status</th><th>Nav</th><th>Order</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Title</td>
            <td class="muted">/@(((Dictionary<int, string>)ViewBag.Paths)[p.PageID])</td>
            <td class="muted">@(p.ParentPage?.Title ?? "—")</td>
            <td><partial name="_StatusBadge" model="p.Status" /></td>
            <td>@(p.ShowInNavigation ? "Yes" : "—")</td>
            <td>@p.SortOrder</td>
            <td style="text-align:right">
                <a class="btn btn-sm" asp-action="Edit" asp-route-id="@p.PageID" title="Edit" aria-label="Edit"><i class="fa-solid fa-pencil"></i></a>
                <form asp-action="Delete" asp-route-id="@p.PageID" method="post" onsubmit="return confirm('Delete this page?');" style="display:inline">
                    <button class="btn btn-sm" type="submit" title="Delete" aria-label="Delete"><i class="fa-solid fa-trash-can"></i></button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Count == 0)
    {
        <tr><td colspan="7" class="muted">No pages yet.</td></tr>
    }
    </tbody>
</table>
