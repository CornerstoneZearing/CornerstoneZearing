@model List<Page>
@{
    ViewData["Title"] = "Pages";
}
<div class="page-header">
    <h1>Pages</h1>
    <a class="btn btn-primary" asp-action="Create">New Page</a>
</div>
<table class="data">
    <thead>
    <tr><th>Title</th><th>Slug</th><th>Parent</th><th>Status</th><th>Nav</th><th>Order</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td><a asp-action="Edit" asp-route-id="@p.PageID">@p.Title</a></td>
            <td class="muted">/@p.Slug</td>
            <td class="muted">@(p.ParentPage?.Title ?? "—")</td>
            <td><partial name="_StatusBadge" model="p.Status" /></td>
            <td>@(p.ShowInNavigation ? "Yes" : "—")</td>
            <td>@p.SortOrder</td>
            <td style="text-align:right">
                <form asp-action="Delete" asp-route-id="@p.PageID" method="post" onsubmit="return confirm('Delete this page?');" style="display:inline">
                    <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Count == 0)
    {
        <tr><td colspan="7" class="muted">No pages yet.</td></tr>
    }
    </tbody>
</table>
