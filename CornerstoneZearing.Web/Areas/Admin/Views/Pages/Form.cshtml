@model PageFormModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment
@{
	var isEdit = Model.PageID != Guid.Empty;
	ViewData["Section"] = "Pages";
	ViewData["Title"] = isEdit ? "Edit Page" : "Add Page";

	var templatesPath = System.IO.Path.Combine(WebHostEnvironment.ContentRootPath, "Views", "Templates");
	var templateNames = System.IO.Directory.Exists(templatesPath)
		? System.IO.Directory.GetFiles(templatesPath, "*.cshtml")
			.Select(f => System.IO.Path.GetFileNameWithoutExtension(f)!)
			.OrderBy(n => n)
			.ToList()
		: new List<string>();
}

<div class="page-header">
	<h1>@(isEdit ? "Edit Page" : "Add Page")</h1>
	<a asp-action="Index" class="btn btn-secondary">
		<i class="fas fa-arrow-left"></i> Back
	</a>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post" id="pageForm">
	@if (isEdit)
	{
		<input asp-for="PageID" type="hidden" />
	}
	<div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

	<div class="row">
		<div class="col-lg-8">
			<div class="card">
				<div class="card-header">
					Page Content
				</div>
				<div class="card-body">
					<div class="form-group">
						<label asp-for="Name"></label>
						<input asp-for="Name" class="form-control" id="pageName" />
						<span asp-validation-for="Name" class="field-validation-error"></span>
					</div>
					<div class="form-group">
						<label asp-for="ContentHtml"></label>
						<div id="contentEditor" class="form-control" style="min-height: 15em; height: auto;"></div>
						<input type="hidden" asp-for="ContentHtml" id="contentInput" />
						<input type="hidden" asp-for="ContentJson" id="contentJsonInput" />
						<span asp-validation-for="ContentHtml" class="field-validation-error"></span>
					</div>
				</div>
			</div>
			<div class="card">
				<div class="card-header">
					SEO
				</div>
				<div class="card-body">
					<div class="form-group">
						<label asp-for="MetaTitle"></label>
						<input asp-for="MetaTitle" class="form-control" />
						<span asp-validation-for="MetaTitle" class="field-validation-error"></span>
					</div>
					<div class="form-group">
						<label asp-for="MetaDescription"></label>
						<textarea asp-for="MetaDescription" class="form-control" rows="3"></textarea>
						<span asp-validation-for="MetaDescription" class="field-validation-error"></span>
					</div>
				</div>
			</div>
		</div>
		<div class="col-lg-4">
			<div class="card">
				<div class="card-header">Publish</div>
				<div class="card-body">
					<div class="form-group">
						<label asp-for="Status"></label>
						<select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<CornerstoneZearing.Data.PageStatus>()"></select>
						<span asp-validation-for="Status" class="field-validation-error"></span>
					</div>
					<div class="form-actions">
						<button type="submit" class="btn btn-primary">
							<i class="fas fa-floppy-disk"></i> @(isEdit ? "Save Changes" : "Save Page")
						</button>
					</div>
				</div>
			</div>
			<div class="card">
				<div class="card-header">URL</div>
				<div class="card-body">
					<div class="form-group">
						<label asp-for="ParentPageID"></label>
						<select asp-for="ParentPageID" class="form-control" asp-items="ViewBag.ParentPages">
							<option value="">— None (top-level page) —</option>
						</select>
						<span asp-validation-for="ParentPageID" class="field-validation-error"></span>
					</div>
					<div class="form-group">
						<label asp-for="UrlSlug"></label>
						<div class="input-group">
							<span class="input-group-text" id="basic-addon1">/</span>
							<input asp-for="UrlSlug" class="form-control" id="urlSlug" />
						</div>
						<span asp-validation-for="UrlSlug" class="field-validation-error"></span>
					</div>
				</div>
			</div>
			<div class="card">
				<div class="card-header">Template</div>
				<div class="card-body">
					<div class="form-group">
						<label asp-for="TemplateName"></label>
						<select asp-for="TemplateName" class="form-control" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(templateNames))"></select>
						<span asp-validation-for="TemplateName" class="field-validation-error"></span>
					</div>
				</div>
			</div>
		</div>
	</div>
</form>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />

	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/editorjs@2.31.6/dist/editorjs.umd.js" integrity="sha384-GD/okP6ykDTeZ/l96nAWwMNN+U76lsX9WmEFpA4OQxpM2Ymz52nGfZBlj0H2vAfI" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/paragraph@2.11.7/dist/paragraph.umd.js" integrity="sha384-lLK35tPhwDTnFk6ouQhe86GxDo5/HUCzSZQYPRF3rdLQ8I+ay/a2W1ygFwApL6uc" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/header@2.8.9/dist/header.umd.js" integrity="sha384-gsHcARcunRrx+hZA2vZY6ESWTIC8ZJZpyuAjNmKponX5ftG43VHfZ8geURncPDPh" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/list@2.0.9/dist/editorjs-list.umd.js" integrity="sha384-rgmnoyP4Ld6tRkTXoq965fzulyZZ6NSUYy+JYI4mO9sxaJDrpyjORlNUz5Un2gbn" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/quote@2.7.6/dist/quote.umd.js" integrity="sha384-z43sl0T5c0VaZ0qANtyMgguU+QmuuzTmE4lWCjGDs2IgVrbQn6ycdbCwemISQxug" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/image@2.10.3/dist/image.umd.js" integrity="sha384-x+8X+am+peBvhMXyUZDpid1xuh/eJzrRGmPT7082F3Q4BL+GFvqjtx+b/MavaMhc" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/simple-image@1.6.0/dist/simple-image.umd.js" integrity="sha384-6UOsVoZI1zqEHXqw1VYbchP7bGaUI/Z1gWv+5YlCZkSd9QV+46MAgSfofoSMnJ1W" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/embed@2.8.0/dist/embed.umd.js" integrity="sha384-/1ZI1HlHcevdvuxte+CPpgCdkHnvAqD4P9oyVCu1bxTotpiAJDerFB+SObio3CH1" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/table@2.4.5/dist/table.umd.js" integrity="sha384-S4yr1Wph77OThIDFdaD2thqwWO3tHs92hWe5NxTHxEmQsYoonlB4fLiKH9ZyfZEi" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/code@2.9.4/dist/code.umd.js" integrity="sha384-pmKzfNHAxgIHBx/Nzm5HVAQyKQwkM/Mpcm2NSVPojR03VCm4g2kYBgzY9FsE4cXa" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/delimiter@1.4.2/dist/delimiter.umd.js" integrity="sha384-JxFg+sowMd+b7DsI8bCOvXPDtHPiIjXxSMk9WXaGWpDtSwzzMIb+tGwkaAh9qMgB" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/warning@1.4.1/dist/warning.umd.js" integrity="sha384-ffeWk9dl1hzdMGuat8++w1VDrkssXdtXZ0TUEqlGOKxUfDgjO7ybm/+VHoReHrty" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/checklist@1.6.0/dist/checklist.umd.js" integrity="sha384-0BqF+qLJW3rgkQbEXSAPhd2gF6Xwk49oPrdpj1vTJP8oD38jxRANuMVPYi0ehfVr" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/raw@2.5.1/dist/raw.umd.js" integrity="sha384-SnKuY1dyCiUIK4MoMUEprsVtxaN/aMGLqyipRou/Wyc3E2PZTEITsxTvoIq2RXTb" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/link@2.6.2/dist/link.umd.js" integrity="sha384-Iw/odmBiXm0ipItxVU/BfOAUoOfCumhS10/M4Jfmum8KmYhHIfW9T+0HJYKKfpPo" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/marker@1.4.0/dist/marker.umd.js" integrity="sha384-xCW2AjuNs2r576ct9AvLo3Knz4N5tsszNVGXueZc7eI1iTEL0NSFy47G1er+diE+" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/inline-code@1.5.2/dist/inline-code.umd.js" integrity="sha384-+3JnsZ5Ef/PXN4aILTy12X6yX8sSVv213uEX7F8ab9j3aBMj/7sypQGQad44v5jo" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/underline@1.2.1/dist/underline.umd.js" integrity="sha384-dnYKCq4EytQYj/90VpMbfms5RNP8MDTU7qLiIvOGJSCtpynWiaqUQ1Vclblc0Zdd" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/editorjs-html@4.0.5/.build/edjsHTML.browser.js" integrity="sha384-SOLhp/nkyKm7D61Z+nFKn1uI3atHm0Vu1jMVXSWOW44KWPTCEpfbXix2MjOK5MoB" crossorigin="anonymous"></script>
	<script src="~/scripts/editorjs-bootstrap-card.js"></script>

	<script>
		const contentInput = document.getElementById('contentInput');
		const contentJsonInput = document.getElementById('contentJsonInput');
		const initialContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ContentHtml ?? string.Empty));
		const initialContentJsonRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ContentJson));
		const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

		// Prefer the editor's own JSON (full block fidelity) when we have it; pages saved
		// before this JSON was tracked, or never re-saved since, fall back to one raw HTML block.
		const initialData = initialContentJsonRaw
			? JSON.parse(initialContentJsonRaw)
			: { blocks: initialContent ? [{ type: 'raw', data: { html: initialContent } }] : [] };

		const contentEditor = new EditorJS({
			holder: 'contentEditor',
			placeholder: 'Write the page content...',
			data: initialData,
			tools: {
				paragraph: { class: Paragraph, inlineToolbar: true },
				header: { class: Header, inlineToolbar: true },
				list: { class: EditorjsList, inlineToolbar: true },
				quote: { class: Quote, inlineToolbar: true },
				image: {
					class: ImageTool,
					config: {
						uploader: {
							uploadByFile(file) {
								const formData = new FormData();
								formData.append('file', file);
								formData.append('__RequestVerificationToken', antiForgeryToken);
								return fetch('@Url.Action("Upload", "Media", new { area = "Admin" })', {
									method: 'POST',
									headers: { 'Accept': 'application/json' },
									body: formData
								})
								.then(r => r.json())
								.then(data => data.success
									? { success: 1, file: { url: data.url } }
									: { success: 0 });
							}
						}
					}
				},
				simpleImage: SimpleImage,
				embed: Embed,
				table: { class: Table, inlineToolbar: true },
				code: CodeTool,
				delimiter: Delimiter,
				warning: { class: Warning, inlineToolbar: true },
				checklist: { class: Checklist, inlineToolbar: true },
				raw: RawTool,
				linkTool: LinkTool,
				marker: Marker,
				inlineCode: InlineCode,
				underline: Underline,
				card: {
					class: BootstrapCardTool,
					config: {
						mediaListUrl: '@Url.Action("List", "Media", new { area = "Admin" })',
						uploadUrl: '@Url.Action("Upload", "Media", new { area = "Admin" })',
						antiForgeryToken: antiForgeryToken
					}
				}
			}
		});

		// Only the block types configured above are ever produced by the editor, so every
		// type has an explicit HTML parser here (editorjs-html's built-ins cover the rest).
		const escAttr = value => (value || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;');

		const edjsParser = edjsHTML({
			table: block => '<table><tbody>' + block.data.content.map(row =>
				'<tr>' + row.map(cell => `<td>${cell}</td>`).join('') + '</tr>'
			).join('') + '</tbody></table>',
			warning: block => `<div class="callout callout-warning"><strong>${block.data.title}</strong><p>${block.data.message}</p></div>`,
			checklist: block => '<ul class="checklist">' + block.data.items.map(item =>
				`<li><input type="checkbox" disabled${item.checked ? ' checked' : ''}> ${item.text}</li>`
			).join('') + '</ul>',
			raw: block => block.data.html,
			simpleImage: block => `<img src="${block.data.url}" alt="${block.data.caption || ''}">` + (block.data.caption ? `<figcaption>${block.data.caption}</figcaption>` : ''),
			linkTool: block => `<a href="${block.data.link}" target="_blank" rel="noopener noreferrer">${(block.data.meta && block.data.meta.title) || block.data.link}</a>`,
			card: block => {
				const d = block.data;
				const image = d.imageUrl ? `<img src="${escAttr(d.imageUrl)}" class="card-img-top" alt="${escAttr(d.imageAlt)}">` : '';
				const title = d.title ? `<h5 class="card-title">${d.title}</h5>` : '';
				const text = d.text ? `<p class="card-text">${d.text}</p>` : '';
				const link = d.linkUrl ? `<a href="${escAttr(d.linkUrl)}" class="btn btn-primary">${d.linkText || 'Learn More'}</a>` : '';
				return `<div class="card">${image}<div class="card-body">${title}${text}${link}</div></div>`;
			}
		});

		document.getElementById('pageForm').addEventListener('submit', function(e) {
			if (contentInput.dataset.saved === 'true') {
				return;
			}
			e.preventDefault();
			const form = e.target;
			contentEditor.save().then(function(outputData) {
				contentInput.value = edjsParser.parse(outputData);
				contentJsonInput.value = JSON.stringify(outputData);
				contentInput.dataset.saved = 'true';
				form.submit();
			}).catch(function(err) {
				console.error('Failed to save page content from the editor.', err);
				alert('The page content could not be saved:\n\n' + (err && (err.stack || err.message || err)));
			});
		});
	</script>
	@if (!isEdit)
	{
		<script>
			const nameInput = document.getElementById('pageName');
			const slugInput = document.getElementById('urlSlug');
			let slugEdited = false;

			slugInput.addEventListener('input', () => { slugEdited = true; });

			nameInput.addEventListener('input', () => {
				if (slugEdited) return;
				slugInput.value = nameInput.value
					.toLowerCase()
					.trim()
					.replace(/[^a-z0-9\s-]/g, '')
					.replace(/\s+/g, '-')
					.replace(/-+/g, '-');
			});
		</script>
	}
}