@model List<Sidebar>
@{ ViewData["Title"] = "Sidebars"; }
<div class="page-header">
    <h1>Sidebars</h1>
    <a class="btn btn-primary" asp-action="Create">New Sidebar</a>
</div>
<table class="data">
    <thead><tr><th>Title</th><th>Modified</th><th></th></tr></thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.Title</td>
            <td class="muted">@s.DateModified.ToString("MMM d, yyyy")</td>
            <td style="text-align:right">
                <a class="btn btn-sm" asp-action="Edit" asp-route-id="@s.SidebarID" title="Edit" aria-label="Edit"><i class="fa-solid fa-pencil"></i></a>
                <form asp-action="Delete" asp-route-id="@s.SidebarID" method="post" onsubmit="return confirm('Delete this sidebar?');" style="display:inline">
                    <button class="btn btn-sm" type="submit" title="Delete" aria-label="Delete"><i class="fa-solid fa-trash-can"></i></button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="3" class="muted">No sidebars yet.</td></tr> }
    </tbody>
</table>
