@model SidebarEditViewModel
@{
    var isNew = Model.SidebarID == 0;
    ViewData["Title"] = isNew ? "New sidebar" : "Edit sidebar";
}
<div class="page-header">
    <h1>@ViewData["Title"]</h1>
    <a class="btn btn-ghost" asp-action="Index">Back</a>
</div>
<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.SidebarID" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <div class="card" style="max-width:760px"><div class="card-body">
        <div class="form-row">
            <label asp-for="Title"></label>
            <input asp-for="Title" />
            <span asp-validation-for="Title" class="field-validation-error"></span>
        </div>
        <div class="form-row">
            <label>Content</label>
            <partial name="_EditorJs" model="Model.ContentJson" />
        </div>
    </div></div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save sidebar</button>
        <a class="btn btn-ghost" asp-action="Index">Cancel</a>
    </div>
</form>
