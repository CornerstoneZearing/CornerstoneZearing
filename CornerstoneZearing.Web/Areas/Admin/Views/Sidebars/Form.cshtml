@model SidebarFormModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment
@{
	var isEdit = Model.SidebarID != Guid.Empty;
	ViewData["Section"] = "Sidebars";
	ViewData["Title"] = isEdit ? "Edit Sidebar" : "Add Sidebar";
}

<div class="page-header">
	<h1>@(isEdit ? "Edit Sidebar" : "Add Sidebar")</h1>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post" id="sidebarForm">
	@if (isEdit)
	{
		<input asp-for="SidebarID" type="hidden" />
	}
	<div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

	<div class="row">
		<div class="col-lg-9">
			<div class="card">
				<div class="card-header">
					Sidebar Content
				</div>
				<div class="card-body">
					<div class="form-group">
						<label asp-for="Name"></label>
						<input asp-for="Name" class="form-control" id="sidebarName" />
						<span asp-validation-for="Name" class="field-validation-error"></span>
					</div>
					<div class="form-group">
						<label asp-for="ContentHtml"></label>
						<div id="contentEditor" class="form-control" style="min-height: 15em; height: auto;"></div>
						<input type="hidden" asp-for="ContentHtml" id="contentInput" />
						<input type="hidden" asp-for="ContentJson" id="contentJsonInput" />
						<span asp-validation-for="ContentHtml" class="field-validation-error"></span>
					</div>
				</div>
			</div>
		</div>
		<div class="col-lg-3">
			<div class="card">
				<div class="card-header">Save</div>
				<div class="card-body">
					<button type="submit" class="btn btn-primary" style="width:100%;">
						<i class="fas fa-floppy-disk"></i> Save Sidebar
					</button>
					<div style="margin-top:.6rem;">
						<a asp-action="Index" class="btn btn-secondary" style="width:100%;justify-content:center;">
							Cancel
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</form>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />

	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/editorjs@2.31.6/dist/editorjs.umd.js" integrity="sha384-GD/okP6ykDTeZ/l96nAWwMNN+U76lsX9WmEFpA4OQxpM2Ymz52nGfZBlj0H2vAfI" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/paragraph@2.11.7/dist/paragraph.umd.js" integrity="sha384-lLK35tPhwDTnFk6ouQhe86GxDo5/HUCzSZQYPRF3rdLQ8I+ay/a2W1ygFwApL6uc" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/header@2.8.9/dist/header.umd.js" integrity="sha384-gsHcARcunRrx+hZA2vZY6ESWTIC8ZJZpyuAjNmKponX5ftG43VHfZ8geURncPDPh" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/list@2.0.9/dist/editorjs-list.umd.js" integrity="sha384-rgmnoyP4Ld6tRkTXoq965fzulyZZ6NSUYy+JYI4mO9sxaJDrpyjORlNUz5Un2gbn" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/quote@2.7.6/dist/quote.umd.js" integrity="sha384-z43sl0T5c0VaZ0qANtyMgguU+QmuuzTmE4lWCjGDs2IgVrbQn6ycdbCwemISQxug" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/simple-image@1.6.0/dist/simple-image.umd.js" integrity="sha384-6UOsVoZI1zqEHXqw1VYbchP7bGaUI/Z1gWv+5YlCZkSd9QV+46MAgSfofoSMnJ1W" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/embed@2.8.0/dist/embed.umd.js" integrity="sha384-/1ZI1HlHcevdvuxte+CPpgCdkHnvAqD4P9oyVCu1bxTotpiAJDerFB+SObio3CH1" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/table@2.4.5/dist/table.umd.js" integrity="sha384-S4yr1Wph77OThIDFdaD2thqwWO3tHs92hWe5NxTHxEmQsYoonlB4fLiKH9ZyfZEi" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/code@2.9.4/dist/code.umd.js" integrity="sha384-pmKzfNHAxgIHBx/Nzm5HVAQyKQwkM/Mpcm2NSVPojR03VCm4g2kYBgzY9FsE4cXa" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/delimiter@1.4.2/dist/delimiter.umd.js" integrity="sha384-JxFg+sowMd+b7DsI8bCOvXPDtHPiIjXxSMk9WXaGWpDtSwzzMIb+tGwkaAh9qMgB" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/raw@2.5.1/dist/raw.umd.js" integrity="sha384-SnKuY1dyCiUIK4MoMUEprsVtxaN/aMGLqyipRou/Wyc3E2PZTEITsxTvoIq2RXTb" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/marker@1.4.0/dist/marker.umd.js" integrity="sha384-xCW2AjuNs2r576ct9AvLo3Knz4N5tsszNVGXueZc7eI1iTEL0NSFy47G1er+diE+" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/inline-code@1.5.2/dist/inline-code.umd.js" integrity="sha384-+3JnsZ5Ef/PXN4aILTy12X6yX8sSVv213uEX7F8ab9j3aBMj/7sypQGQad44v5jo" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/@@editorjs/underline@1.2.1/dist/underline.umd.js" integrity="sha384-dnYKCq4EytQYj/90VpMbfms5RNP8MDTU7qLiIvOGJSCtpynWiaqUQ1Vclblc0Zdd" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/editorjs-html@4.0.5/.build/edjsHTML.browser.js" integrity="sha384-SOLhp/nkyKm7D61Z+nFKn1uI3atHm0Vu1jMVXSWOW44KWPTCEpfbXix2MjOK5MoB" crossorigin="anonymous"></script>
	<script src="~/scripts/editorjs-bootstrap-card.js"></script>
	<script src="~/scripts/editorjs-media-image.js"></script>

	<script>
		const contentInput = document.getElementById('contentInput');
		const contentJsonInput = document.getElementById('contentJsonInput');
		const initialContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ContentHtml ?? string.Empty));
		const initialContentJsonRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ContentJson));
		const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

		// Prefer the editor's own JSON (full block fidelity) when we have it; sidebars saved
		// before this JSON was tracked, or never re-saved since, fall back to one raw HTML block.
		const initialData = initialContentJsonRaw
			? JSON.parse(initialContentJsonRaw)
			: { blocks: initialContent ? [{ type: 'raw', data: { html: initialContent } }] : [] };

		const contentEditor = new EditorJS({
			holder: 'contentEditor',
			placeholder: 'Write the sidebar content...',
			data: initialData,
			tools: {
				paragraph: { class: Paragraph, inlineToolbar: true },
				header: { class: Header, inlineToolbar: true },
				list: { class: EditorjsList, inlineToolbar: true },
				quote: { class: Quote, inlineToolbar: true },
				image: {
					class: MediaImageTool,
					config: {
						mediaListUrl: '@Url.Action("List", "Media", new { area = "Admin" })',
						uploadUrl: '@Url.Action("Upload", "Media", new { area = "Admin" })',
						antiForgeryToken: antiForgeryToken
					}
				},
				simpleImage: SimpleImage,
				embed: Embed,
				table: { class: Table, inlineToolbar: true },
				code: CodeTool,
				delimiter: Delimiter,
				raw: RawTool,
				marker: Marker,
				inlineCode: InlineCode,
				underline: Underline,
				card: {
					class: BootstrapCardTool,
					config: {
						mediaListUrl: '@Url.Action("List", "Media", new { area = "Admin" })',
						uploadUrl: '@Url.Action("Upload", "Media", new { area = "Admin" })',
						antiForgeryToken: antiForgeryToken
					}
				}
			}
		});

		// Only the block types configured above are ever produced by the editor, so every
		// type has an explicit HTML parser here (editorjs-html's built-ins cover the rest).
		const escAttr = value => (value || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;');

		const edjsParser = edjsHTML({
			table: block => '<table><tbody>' + block.data.content.map(row =>
				'<tr>' + row.map(cell => `<td>${cell}</td>`).join('') + '</tr>'
			).join('') + '</tbody></table>',
			raw: block => block.data.html,
			simpleImage: block => `<img src="${block.data.url}" alt="${block.data.caption || ''}">` + (block.data.caption ? `<figcaption>${block.data.caption}</figcaption>` : ''),
			image: block => `<p><img src="${escAttr(block.data.url)}" alt="${escAttr(block.data.alt)}" class="img-fluid"></p>` + (block.data.caption ? `<figcaption>${block.data.caption}</figcaption>` : ''),
			card: block => {
				const d = block.data;
				const image = d.imageUrl ? `<img src="${escAttr(d.imageUrl)}" class="card-img-top" alt="${escAttr(d.imageAlt)}">` : '';
				const title = d.title ? `<h5 class="card-title">${d.title}</h5>` : '';
				const text = d.text ? `<p class="card-text">${d.text}</p>` : '';
				const link = d.linkUrl ? `<a href="${escAttr(d.linkUrl)}" class="btn btn-primary">${d.linkText || 'Learn More'}</a>` : '';
				return `<div class="card">${image}<div class="card-body">${title}${text}${link}</div></div>`;
			}
		});

		document.getElementById('sidebarForm').addEventListener('submit', function(e) {
			if (contentInput.dataset.saved === 'true') {
				return;
			}
			e.preventDefault();
			const form = e.target;
			contentEditor.save().then(function(outputData) {
				contentInput.value = edjsParser.parse(outputData);
				contentJsonInput.value = JSON.stringify(outputData);
				contentInput.dataset.saved = 'true';
				form.submit();
			}).catch(function(err) {
				console.error('Failed to save sidebar content from the editor.', err);
				alert('The sidebar content could not be saved:\n\n' + (err && (err.stack || err.message || err)));
			});
		});
	</script>
}