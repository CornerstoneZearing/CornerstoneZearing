@model List<Event>
@{ ViewData["Title"] = "Events"; }
<div class="page-header">
    <h1>Events</h1>
    <a class="btn btn-primary" asp-action="Create">New Event</a>
</div>
<table class="data">
    <thead><tr><th>Title</th><th>Start</th><th>Location</th><th>Recurs</th><th>Visibility</th><th></th></tr></thead>
    <tbody>
    @foreach (var e in Model)
    {
        <tr>
            <td>@e.Title</td>
            <td class="muted">@(e.AllDay ? e.StartDateTime.ToString("MMM d, yyyy") + " (all day)" : e.StartDateTime.ToString("MMM d, yyyy h:mm tt"))</td>
            <td class="muted">@(e.Location ?? "—")</td>
            <td class="muted">@(string.IsNullOrWhiteSpace(e.RecurrenceRule) ? "—" : "Yes")</td>
            <td>@(e.Private ? "Private" : "Public")</td>
            <td style="text-align:right">
                <a class="btn btn-sm" asp-action="Edit" asp-route-id="@e.EventID" title="Edit" aria-label="Edit"><i class="fa-solid fa-pencil"></i></a>
                <form asp-action="Delete" asp-route-id="@e.EventID" method="post" onsubmit="return confirm('Delete this event?');" style="display:inline">
                    <button class="btn btn-sm" type="submit" title="Delete" aria-label="Delete"><i class="fa-solid fa-trash-can"></i></button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="6" class="muted">No events yet.</td></tr> }
    </tbody>
</table>
