@model EventEditViewModel
@{
    var isNew = Model.EventID == 0;
    ViewData["Title"] = isNew ? "New event" : "Edit event";
}
<div class="page-header">
    <h1>@ViewData["Title"]</h1>
    <a class="btn btn-ghost" asp-action="Index">Back to events</a>
</div>
<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.EventID" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="validation-summary-errors"></div>
    <div class="form-grid">
        <div class="card"><div class="card-body">
            <div class="form-row">
                <label asp-for="Title"></label>
                <input asp-for="Title" />
                <span asp-validation-for="Title" class="field-validation-error"></span>
            </div>
            <div class="form-row">
                <label asp-for="StartDateTime">Start</label>
                <input asp-for="StartDateTime" type="datetime-local" />
            </div>
            <div class="form-row">
                <label asp-for="EndDateTime">End</label>
                <input asp-for="EndDateTime" type="datetime-local" />
                <span asp-validation-for="EndDateTime" class="field-validation-error"></span>
            </div>
            <div class="form-row">
                <label asp-for="Location"></label>
                <input asp-for="Location" />
            </div>
            <div class="form-row">
                <label asp-for="Description"></label>
                <textarea asp-for="Description"></textarea>
            </div>
        </div></div>
        <div class="card"><div class="card-body">
            <div class="form-row checkbox-row">
                <input asp-for="Private" />
                <label asp-for="Private" style="margin:0">Private (hidden from public calendar)</label>
            </div>
            <h4 style="margin:16px 0 8px">Recurrence</h4>
            <div class="form-row">
                <label>Pattern</label>
                <select id="recurrence-preset" onchange="applyPreset(this.value)">
                    <option value="">Does not repeat</option>
                    <option value="FREQ=DAILY">Daily</option>
                    <option value="FREQ=WEEKLY">Weekly</option>
                    <option value="FREQ=WEEKLY;INTERVAL=2">Every 2 weeks</option>
                    <option value="FREQ=MONTHLY">Monthly</option>
                    <option value="FREQ=YEARLY">Yearly</option>
                </select>
            </div>
            <div class="form-row">
                <label asp-for="RecurrenceRule">RRULE (RFC 5545)</label>
                <input asp-for="RecurrenceRule" placeholder="FREQ=WEEKLY;BYDAY=SU" />
                <div class="hint">Leave blank for a one-time event. Presets above fill this in; edit freely.</div>
            </div>
            <div class="form-row">
                <label asp-for="RecurrenceEndDate">Repeat until</label>
                <input asp-for="RecurrenceEndDate" type="date" />
            </div>
            <div class="form-row">
                <label asp-for="RecurrenceExceptions">Skip dates</label>
                <textarea asp-for="RecurrenceExceptions" placeholder="One date per line, e.g. 2026-12-25T09:00:00"></textarea>
            </div>
        </div></div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save event</button>
        <a class="btn btn-ghost" asp-action="Index">Cancel</a>
    </div>
</form>
@section Scripts {
<script>
    function applyPreset(v) { if (v) document.getElementById("RecurrenceRule").value = v; }
</script>
}
